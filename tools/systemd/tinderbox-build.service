# Keeps dist/ built from the main checkout, which tailscale serves at
# https://bifrost.tail2280a0.ts.net:8451/. Rebuilds whenever main's sources change
# (e.g. after a merge), so the tailnet copy stays current.
# Installed with: systemctl --user link ~/Projects/tinderbox/tools/systemd/tinderbox-build.service
#                 systemctl --user enable --now tinderbox-build
# Uses the fnm default node, so it follows `fnm default` upgrades.

[Unit]
Description=tinderbox build watcher (dist/ for the tailnet)

[Service]
WorkingDirectory=%h/Projects/tinderbox
ExecStart=%h/.local/share/fnm/aliases/default/bin/node node_modules/vite/bin/vite.js build --watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
