# Vite dev server for tinderbox, served from the main checkout on localhost:5191.
# Installed with: systemctl --user link ~/Projects/tinderbox/tools/systemd/tinderbox-dev.service
#                 systemctl --user enable --now tinderbox-dev
# Uses the fnm default node, so it follows `fnm default` upgrades.

[Unit]
Description=tinderbox Vite dev server

[Service]
WorkingDirectory=%h/Projects/tinderbox
ExecStart=%h/.local/share/fnm/aliases/default/bin/node node_modules/vite/bin/vite.js --port 5191 --strictPort
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
